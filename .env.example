# Copy to .env (gitignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Neo4j (matches docker-compose.yml)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=blastradius-local

# Optional overrides. Defaults are resolved at runtime via the Models API (see `blastradius doctor`).
# BLASTRADIUS_MODEL_CHEAP=
# BLASTRADIUS_MODEL_MID=
# BLASTRADIUS_MODEL_STRONG=

# Spend circuit breaker for one run, in USD (estimate from response.usage, not billing).
BLASTRADIUS_MAX_USD=15

# hash (default): prompts/responses are never written to traces. local: write blobs under data/runs/<id>/blobs.
BLASTRADIUS_TRACE_CONTENT=hash

# Identifiable crawler UA suffix (shown to target sites). Put a real contact URL or address here.
BLASTRADIUS_CONTACT=
